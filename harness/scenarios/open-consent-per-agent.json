{
  "id": "open-consent-per-agent",
  "tier": "E2",
  "classes": ["A", "B", "C", "E", "G", "K"],
  "agents": ["claude-code", "codex"],
  "fixture": {"entries": [{"type": "file", "path": "work.txt", "text": "workspace\n"}]},
  "steps": [
    {"op": "pack"},
    {"op": "open", "args": ["--consent", "claude-code=no,codex=yes"]}
  ],
  "expect": {
    "tree": true,
    "tree_allowed_extra_roots": [".biv/agents"],
    "manifest_variant": "builtin",
    "session_rows": [
      {"agent": "claude-code", "outcome": "staged", "kind": "SessionsStaged"},
      {"agent": "codex", "outcome": "installed"}
    ],
    "target_delta": {"claude-code": "unchanged", "codex": "changed"}
  },
  "held": []
}
