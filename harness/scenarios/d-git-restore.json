{
  "id": "d-git-restore",
  "tier": "E2",
  "classes": [
    "A",
    "B",
    "C",
    "D",
    "E",
    "K"
  ],
  "dor_pointers": [
    "m-3 restore-cli design §6 (A/B/D comparators)",
    "m-1 restore-apply §3 (outcome families)",
    "m3-addendum-10 rev10 LOCKED (--network = non-interactive consent)"
  ],
  "fixture": {
    "entries": [
      {
        "type": "git-bare",
        "id": "origin"
      },
      {
        "type": "file",
        "path": "README.md",
        "text": "workspace root\n"
      },
      {
        "type": "dir",
        "path": "docs"
      },
      {
        "type": "file",
        "path": "docs/notes.txt",
        "text": "penumbra outside the repos\n"
      },
      {
        "type": "git-repo",
        "path": "app",
        "commits": [
          {
            "message": "app: first",
            "files": {
              "src/main.c": "int main(void) { return 0; }\n",
              "README": "app\n"
            }
          },
          {
            "message": "app: second",
            "files": {
              "src/main.c": "int main(void) { return 1; }\n"
            }
          }
        ],
        "branches": {
          "main": 1,
          "side": 0
        },
        "tags": {
          "v1": 0
        },
        "remote": "origin",
        "push": [
          "refs/heads/main",
          "refs/heads/side",
          "refs/tags/v1"
        ]
      },
      {
        "type": "git-repo",
        "path": "lib",
        "commits": [
          {
            "message": "lib: only",
            "files": {
              "lib.h": "#pragma once\n"
            }
          }
        ],
        "branches": {
          "main": 0
        }
      }
    ]
  },
  "steps": [
    {
      "op": "pack"
    },
    {
      "op": "open",
      "args": [
        "--network"
      ]
    }
  ],
  "expect": {
    "tree": true,
    "manifest_variant": "builtin",
    "members_present": [
      "manifest.json",
      "checksums.json"
    ],
    "repo_state": {
      "app": {
        "branch": "main",
        "porcelain_clean": true
      },
      "lib": {
        "branch": "main",
        "porcelain_clean": true
      }
    }
  },
  "held": []
}
