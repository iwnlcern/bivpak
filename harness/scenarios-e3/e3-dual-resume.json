{
  "id": "e3-dual-resume",
  "tier": "E3",
  "classes": ["E3 (real CLI resume in isolated profile)"],
  "checkpoint_count": 1,
  "checkpoint_prompt": "Authenticate both CLIs in the isolated host2 profiles, then press Enter: ",
  "workspace_name": "biv-e3-dual-resume",
  "host2_profile_root": "host2/profiles",
  "live_store_roots": ["~/.claude", "~/.codex"],
  "seed_turns": [
    "BIV_E3_SEED_TURN_ONE_20260711",
    "BIV_E3_SEED_TURN_TWO_20260711"
  ],
  "resume_probe": "BIV_E3_RESUME_PROBE_20260711",
  "credential_scan_sentinels": ["BIV_E3_CREDENTIAL_SENTINEL_MUST_NOT_APPEAR"],
  "model_call_baseline": {"claude-code": 4, "codex": 3},
  "forbidden_bivpak_state": ["host2/.biv", "host2/work/.biv/agents"],
  "agents": [
    {
      "id": "claude-code",
      "live_profile": "~/.claude",
      "host2_profile": "claude",
      "env": {"CLAUDE_CONFIG_DIR": "{profile}"},
      "auth_status": ["claude", "auth", "status"],
      "version_command": ["claude", "--version"],
      "validated_version_prefix": "2.1.",
      "cheapest_model": "haiku",
      "liveness_command": ["claude", "--model", "haiku", "-p", "Reply with one token: OK"],
      "seed_start_command": ["claude", "--model", "haiku", "-p", "BIV_E3_SEED_TURN_ONE_20260711 BIV_E3_CLAUDE_RUN_TOKEN_20260711"],
      "seed_retry_resume_command": ["claude", "--model", "haiku", "-p", "--resume", "{id}", "BIV_E3_SEED_TURN_ONE_20260711 BIV_E3_CLAUDE_RUN_TOKEN_20260711"],
      "seed_continue_command": ["claude", "--model", "haiku", "-p", "--resume", "{id}", "BIV_E3_SEED_TURN_TWO_20260711"],
      "ownership_glob": "*.jsonl",
      "run_token": "BIV_E3_CLAUDE_RUN_TOKEN_20260711",
      "resume_command": ["claude", "--model", "haiku", "-p", "--resume", "{id}", "{probe}"],
      "resume_mutation": "appends-same-file"
    },
    {
      "id": "codex",
      "live_profile": "~/.codex",
      "host2_profile": "codex",
      "env": {"CODEX_HOME": "{profile}"},
      "auth_status": ["codex", "login", "status"],
      "version_command": ["codex", "--version"],
      "validated_version_prefix": "0.142.",
      "cheapest_model": "gpt-5.4-mini",
      "seed_start_command": ["codex", "exec", "--model", "gpt-5.4-mini", "--skip-git-repo-check", "BIV_E3_SEED_TURN_ONE_20260711 BIV_E3_CODEX_RUN_TOKEN_20260711"],
      "seed_retry_resume_command": ["codex", "exec", "--model", "gpt-5.4-mini", "--skip-git-repo-check", "resume", "{id}", "BIV_E3_SEED_TURN_ONE_20260711 BIV_E3_CODEX_RUN_TOKEN_20260711"],
      "seed_continue_command": ["codex", "exec", "--model", "gpt-5.4-mini", "--skip-git-repo-check", "resume", "{id}", "BIV_E3_SEED_TURN_TWO_20260711"],
      "ownership_glob": "rollout-*.jsonl",
      "run_token": "BIV_E3_CODEX_RUN_TOKEN_20260711",
      "resume_command": ["codex", "exec", "--model", "gpt-5.4-mini", "--skip-git-repo-check", "resume", "{id}", "{probe}"],
      "resume_shape": "appends-same-rollout"
    }
  ]
}
