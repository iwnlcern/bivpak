{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-repo-entry-shape-v1",
  "title": "repos[] entry \u2014 the SHAPE layer of the product parser",
  "description": "Transcribed from src/core/manifest/manifest.cpp at 1065872: parse_repo_entry :2257-2303 (required members, types, the capture_mode present-non-null rule), the enum tables :786-800 (kind, head_state, capture_mode), parse_remotes :1929-1949, is_hex_object_id :1786-1791 (the sha_hex clause: size == 40 AND every byte hex \u2014 the length is bounded explicitly because a Python `$` also matches before a final LF). NOT transcribed: repo_row_violation's conditional clause inventory (kRepoRowClauses :963-) \u2014 those stay the product parser's gate.",
  "type": "object",
  "required": [
    "id",
    "relpath",
    "kind",
    "parent_id",
    "remote",
    "remotes",
    "sha",
    "branch",
    "head_state",
    "dirty"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "relpath": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "repo",
        "submodule",
        "nested"
      ]
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "remote": {
      "type": [
        "string",
        "null"
      ]
    },
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "sha": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_state": {
      "enum": [
        "branch",
        "detached",
        "unborn"
      ]
    },
    "dirty": {
      "type": "boolean"
    },
    "capture_mode": {
      "enum": [
        "overlay",
        "full"
      ]
    }
  }
}
