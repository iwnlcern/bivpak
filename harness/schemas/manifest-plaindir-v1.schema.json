{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-plaindir-v1",
  "type": "object",
  "required": [
    "format_version",
    "required_capabilities",
    "image_id",
    "app_version",
    "created_at",
    "source_path",
    "source_path_flavor",
    "bivignore",
    "repos",
    "agent_sessions"
  ],
  "properties": {
    "format_version": {"type": "integer"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "image_id": {"type": "string"},
    "app_version": {"type": "string"},
    "created_at": {"type": "string"},
    "source_path": {"type": "string"},
    "source_path_flavor": {"enum": ["posix", "windows", "wsl"]},
    "bivignore": {
      "type": "object",
      "required": ["source", "builtin_id", "sha256"],
      "properties": {
        "source": {"enum": ["file", "builtin"]},
        "builtin_id": {"type": ["string", "null"]},
        "sha256": {"type": "string"}
      }
    },
    "repos": {"type": "array"},
    "agent_sessions": {"type": "array"}
  }
}
