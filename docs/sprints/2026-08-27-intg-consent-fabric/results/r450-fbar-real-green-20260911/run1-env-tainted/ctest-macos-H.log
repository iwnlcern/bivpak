        monkeypatch.setattr(e3, "_seed_agent", fake_seed)
        monkeypatch.setattr(e3, "scan_image_secret_values", capturing_scan)
        monkeypatch.setattr(e3, "setup_host2_credentials", stop_after_scan)
    
        result = e3.run_e3(
