{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biv-json-envelope.v1",
  "type": "object",
  "description": "ok is true exactly when exit_code is 0 or 2 and error is null. Failure facts are carried under error.facts when known.",
  "required": ["envelope_version", "app_version", "ok", "verb", "exit_code", "warnings", "advisories", "result", "error"],
  "properties": {
    "envelope_version": {"const": 1},
    "app_version": {"type": "string"},
    "ok": {"type": "boolean"},
    "verb": {"enum": ["pack", "open", "list", "info"]},
    "exit_code": {"type": "integer"},
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "artifact": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0, "description": "Artifact size in bytes."},
          "detail": {"type": "string"}
        }
      }
    },
    "advisories": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "entries"],
            "properties": {
              "kind": {"const": "prune-summary"},
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "source"],
                  "properties": {
                    "path": {"type": "string"},
                    "source": {
                      "type": "string",
                      "description": "Exactly builtin-v1 or .bivignore:<N>, where N is a 1-based root .bivignore line number."
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["kind", "paths"],
            "properties": {
              "kind": {"const": "nested-bivignore-ignored"},
              "paths": {"type": "array", "items": {"type": "string"}}
            }
          }
        ]
      }
    },
    "result": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "image_path": {"type": "string"},
            "source_path": {"type": "string"},
            "source_path_flavor": {"enum": ["posix", "windows", "wsl"]},
            "image_id": {"type": "string"},
            "member_count": {"type": "integer"},
            "payload_bytes": {"type": "integer"},
            "output_dir": {"type": "string"},
            "collision_action": {"enum": ["none", "renamed", "refused"]},
            "restored_member_count": {"type": "integer"},
            "checksums_verified": {"type": "boolean"},
            "sessions": {
              "type": "object",
              "required": ["prompt_shown", "warning_shown", "consent", "agents"],
              "properties": {
                "prompt_shown": {"type": "boolean"},
                "warning_shown": {"type": "boolean"},
                "consent": {
                  "type": "object",
                  "required": ["source", "values"],
                  "properties": {
                    "source": {"enum": ["flag", "prompt", "deny-default"]},
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["agent", "value"],
                        "properties": {
                          "agent": {"type": "string"},
                          "value": {"enum": ["yes", "no"]}
                        }
                      }
                    }
                  }
                },
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["agent", "capabilities_verdict", "store_root", "sessions", "activation", "caveats"],
                    "properties": {
                      "agent": {"type": "string"},
                      "capabilities_verdict": {"enum": ["readable-newer-than-survey", "readable", "unreadable", "absent"]},
                      "probe": {
                        "type": "object",
                        "required": ["agent", "requested", "executed", "pinned", "outcome", "exit_code", "raw", "parsed"],
                        "properties": {
                          "agent": {"type": "string"},
                          "requested": {"type": ["string", "null"]},
                          "executed": {"type": ["string", "null"]},
                          "pinned": {"type": "boolean"},
                          "outcome": {"enum": ["ok", "not_found", "not_executable", "not_accessible", "spawn_error", "nonzero_exit", "timeout", "unparseable", "probe_io_error"]},
                          "exit_code": {"type": "integer"},
                          "raw": {"type": "string"},
                          "parsed": {"type": ["string", "null"]}
                        }
                      },
                      "store_root": {"type": "string"},
                      "sessions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["image_session_id", "outcome", "host_version_unverified", "activation_suppressed"],
                          "properties": {
                            "image_session_id": {"type": "string"},
                            "installed_session_id": {"type": "string"},
                            "outcome": {"enum": ["installed", "staged", "skipped", "failed"]},
                            "kind": {"enum": ["ContainmentRefused", "SessionInstallFailed", "UnknownAgentSkipped", "EntrySchemaSkipped", "SessionsConsentSkipped", "SessionsStaged", "AgentNotValidatedFailed"]},
                            "reason": {"type": "string"},
                            "host_version_unverified": {"type": "boolean"},
                            "activation_suppressed": {"type": "boolean"}
                          },
                          "allOf": [
                            {
                              "if": {"properties": {"outcome": {"enum": ["skipped", "failed"]}}},
                              "then": {"required": ["kind"]}
                            }
                          ]
                        }
                      },
                      "activation": {"type": "array", "items": {"type": "string"}},
                      "caveats": {"type": "array", "items": {"type": "string"}}
                    }
                  }
                }
              }
            },
            "manifest": {
              "type": "object",
              "required": ["format_version", "repos", "agent_sessions"],
              "properties": {
                "format_version": {"type": "integer"},
                "repos": {"type": "array"},
                "agent_sessions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["agent", "session_count"],
                    "properties": {
                      "agent": {"type": "string"},
                      "session_count": {"type": "integer"}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "error": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["kind", "path", "detail", "errno", "facts"],
          "properties": {
            "kind": {"type": "string"},
            "path": {"type": "string"},
            "detail": {"type": "string"},
            "errno": {"type": "integer"},
            "facts": {
              "type": "object",
              "properties": {
                "partial_path": {"type": "string"},
                "spool_path": {"type": "string"},
                "partial_dir": {"type": "string"}
              }
            }
          }
        }
      ]
    }
  }
}
