{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "binaryDir": "build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci",
      "binaryDir": "build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_FLAGS": "-D_FORTIFY_SOURCE=3 -fstack-protector-strong -fstack-clash-protection",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-z,relro,-z,now"
      }
    },
    {
      "name": "ci-macos",
      "binaryDir": "build/ci-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_FLAGS": "-fstack-protector-strong",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON"
      }
    },
    {
      "name": "sanitize",
      "binaryDir": "build/san",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "fuzz",
      "binaryDir": "build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "BIV_ENABLE_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "ci", "configurePreset": "ci"},
    {"name": "ci-macos", "configurePreset": "ci-macos"},
    {"name": "sanitize", "configurePreset": "sanitize"},
    {"name": "fuzz", "configurePreset": "fuzz"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "ci", "configurePreset": "ci"},
    {"name": "ci-macos", "configurePreset": "ci-macos"},
    {"name": "sanitize", "configurePreset": "sanitize"}
  ]
}
